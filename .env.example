# Aether IDP — frontend environment variables (Vite)
# `npm run setup` copies this file to .env (gitignored — edit .env locally).
# With every value blank the app runs in demo/mock mode — no backend needed.
#
# Ports:
#   http://localhost:5174 — dev server (npm run dev; pinned via strictPort)
#   http://localhost:5173 — Docker Compose frontend (docker-compose up)

# Backend API base URL. Leave blank for demo mode — in local dev the Vite
# dev server proxies API calls to the backend on localhost:8001. Set an
# absolute URL only when the frontend is deployed separately (e.g. Vercel).
VITE_API_URL=

# Set to "true" to enable API mode through the Vite dev-server proxy
# (backend on :8001). Leave empty for demo/mock mode with seed data.
# Full-stack local dev (README §7b): set VITE_USE_API=true here.
# Docker builds set this automatically (docker-compose build args).
VITE_USE_API=

# WebSocket URL for real-time events. Dev backend = uvicorn on port 8001.
# (Docker frontend uses ws://localhost:5173 — set in docker-compose.yml.)
VITE_WS_URL=ws://localhost:8001

# Optional — GitHub OAuth app client ID for frontend sign-in.
# The backend needs the matching GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET
# (see backend/.env.example).
VITE_GITHUB_CLIENT_ID=
