# Frontend environment variables
# Copy to .env.local for local development with a running backend.
# When these are not set the app runs in demo/mock mode automatically.

# Backend API base URL (leave blank for demo/mock mode)
VITE_API_URL=http://localhost:8001

# WebSocket URL for real-time events (leave blank for demo/mock mode)
# The backend (uvicorn) runs on http://localhost:8001 — keep this in sync.
VITE_WS_URL=ws://localhost:8001
