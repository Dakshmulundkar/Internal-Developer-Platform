# ─────────────────────────────────────────────────────────────────────────────
# IDP Backend — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
# supabase.com → your project → Settings → API
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# ── Groq AI (REQUIRED for AI incident analysis) ───────────────────────────────
# console.groq.com → API Keys → Create API key (free tier, llama3-8b-8192)
GROQ_API_KEY=

# ── OpenAI (optional fallback — only used if GROQ_API_KEY is not set) ─────────
OPENAI_API_KEY=

# ── Webhook verification secrets ──────────────────────────────────────────────
# Generate any random string and paste the same value into Vercel/Netlify
# webhook settings so signatures match.
VERCEL_WEBHOOK_SECRET=
NETLIFY_WEBHOOK_SECRET=

# ── Provider API tokens (used by deployment sync) ─────────────────────────────
# Vercel: vercel.com → Account Settings → Tokens
VERCEL_API_TOKEN=
# Netlify: app.netlify.com → User Settings → Applications → Personal access tokens
NETLIFY_API_TOKEN=

# ── Grafana ───────────────────────────────────────────────────────────────────
# Base URL of your Grafana instance (e.g. http://grafana.example.com)
GRAFANA_BASE_URL=
# Grafana service account token
GRAFANA_API_KEY=

# ── Sentry ────────────────────────────────────────────────────────────────────
# Sentry organization slug (found in Sentry → Settings → Organization)
SENTRY_ORG=
# Comma-separated project slugs — supports multiple e.g. "idp-frontend,idp-backend"
SENTRY_PROJECTS=
# Sentry auth token — sentry.io → Settings → Auth Tokens (needs project:read + event:read)
SENTRY_TOKEN=

# ── New Relic ─────────────────────────────────────────────────────────────────
# New Relic User API key — one.newrelic.com → (User menu) → API Keys → Create key (type: User)
NEWRELIC_API_KEY=
# New Relic Account ID — visible in the URL: one.newrelic.com/accounts/YOUR-ACCOUNT-ID
NEWRELIC_ACCOUNT_ID=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ── Runtime ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
