# ─────────────────────────────────────────────────────────────────────────────
# IDP Backend — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
#
# Sections:
#   === REQUIRED ===                 — backend boots without them, but login,
#                                      data, and credential storage fail (/health
#                                      reports "degraded")
#   === OPTIONAL ===                 — features degrade gracefully without these
# ─────────────────────────────────────────────────────────────────────────────

# === REQUIRED === ────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# supabase.com → your project → Settings → API
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# ── Plugin API key encryption (Fernet) ────────────────────────────────────────
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, plugin credential storage and auto-fix tokens will not work.
FERNET_KEY=
# Previous key, kept only during rotation (decrypt-only). Leave empty normally.
FERNET_PREVIOUS_KEY=

# === OPTIONAL — features degrade gracefully without these === ────────────────

# ── AI analysis (GROQ is primary, OpenAI is fallback — set at least one) ──────
# console.groq.com → API Keys → Create API key (free tier, llama3-8b-8192)
GROQ_API_KEY=
# Only used if GROQ_API_KEY is not set
OPENAI_API_KEY=

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# github.com → Settings → Developer settings → OAuth Apps → New OAuth App
# Authorization callback URL: {APP_BACKEND_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── App base URLs (override in production) ────────────────────────────────────
# Used for OAuth redirects and link generation. Defaults work for local dev.
APP_FRONTEND_URL=http://localhost:5173
APP_BACKEND_URL=http://localhost:8000

# ── Email (Resend) — notifications fall back to log-only without these ────────
# resend.com → API Keys
RESEND_API_KEY=
FROM_EMAIL=
FROM_NAME=Aether IDP

# ── Webhook verification secrets ──────────────────────────────────────────────
# Generate any random string and paste the same value into Vercel/Netlify
# webhook settings so signatures match.
VERCEL_WEBHOOK_SECRET=
NETLIFY_WEBHOOK_SECRET=
GRAFANA_WEBHOOK_SECRET=
# Shared secret for GitHub security triage webhooks (X-Hub-Signature-256)
# — paste the same value into the GitHub Actions workflow secrets.
GITHUB_WEBHOOK_SECRET=

# ── Provider API tokens (used by deployment sync) ─────────────────────────────
# Vercel: vercel.com → Account Settings → Tokens
VERCEL_API_TOKEN=
# Netlify: app.netlify.com → User Settings → Applications → Personal access tokens
NETLIFY_API_TOKEN=

# ── Event intake (external test runners / telemetry POST /monitoring/events) ──
# Long random token for unauthenticated event ingestion. Without it, anonymous
# callers are rejected (fail-closed).
EVENT_INTAKE_TOKEN=

# ── Plugin OAuth (Slack / Microsoft Teams) ────────────────────────────────────
# Without these, OAuth connect buttons report "not configured" and the
# paste-a-token path keeps working.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common

# ── Grafana ───────────────────────────────────────────────────────────────────
# Base URL of your Grafana instance (e.g. http://grafana.example.com)
GRAFANA_BASE_URL=
# Grafana service account token
GRAFANA_API_KEY=

# ── Sentry ────────────────────────────────────────────────────────────────────
# Sentry organization slug (found in Sentry → Settings → Organization)
SENTRY_ORG=
# Comma-separated project slugs — supports multiple e.g. "idp-frontend,idp-backend"
SENTRY_PROJECTS=
# Sentry auth token — sentry.io → Settings → Auth Tokens (needs project:read + event:read)
SENTRY_TOKEN=

# ── New Relic ─────────────────────────────────────────────────────────────────
# New Relic User API key — one.newrelic.com → (User menu) → API Keys → Create key (type: User)
NEWRELIC_API_KEY=
# New Relic Account ID — visible in the URL: one.newrelic.com/accounts/YOUR-ACCOUNT-ID
NEWRELIC_ACCOUNT_ID=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Runtime ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
