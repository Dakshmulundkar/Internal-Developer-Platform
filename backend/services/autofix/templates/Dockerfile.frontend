# =============================================================================
# Generated by Aether Auto-Fix — Vite/React frontend (multi-stage)
# Builds the app with npm, then serves the static bundle with nginx.
#
# After reviewing: if the frontend calls an API, point those calls at your
# backend service (same-origin proxy or absolute URL) and add the matching
# proxy/service to your compose file — this file serves static assets only.
# =============================================================================

# ── Stage 1: build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json* ./
# `npm ci` needs a lockfile; plain Vite/npm projects always have one.
RUN npm ci

COPY . .
RUN npm run build

# ── Stage 2: serve ───────────────────────────────────────────────────────────
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
